# ---- Trading engine --------------------------------------------
# paper = built-in simulator (no broker needed - use it to test everything)
# mt5   = real/demo MetaTrader 5 account (the Docker stack includes the MT5 desktop)
BROKER_MODE=mt5
PAPER_BALANCE=12
PAPER_SPEED=1
# Broker symbol suffix if your broker uses one (e.g. "m" -> EURUSDm, ".a" -> EURUSD.a). Leave empty to auto-detect.
SYMBOL_SUFFIX=
MAGIC_NUMBER=26101801
# Optional MT5 auto-login (you can also link the account from the app's Settings page)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Windows only: full path to terminal64.exe if MT5 is installed in a non-default place
MT5_PATH=
# Linux / Docker only: host & port of the Wine MT5 container (rpyc)
MT5_RPYC_HOST=
MT5_RPYC_PORT=18812

# ---- MT5 desktop container (started automatically by docker compose) -----
MT5_VNC_USER=admin
MT5_VNC_PASSWORD=Kalimbwejoel@01

